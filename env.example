# Copy this file to .env (cp env.example .env) and fill in the two
# values below. Every tutorial reads this file automatically.

# Your Hugging Face access token, from
# https://huggingface.co/settings/tokens (free account, "read" role).
# Used to download model weights.
HF_TOKEN=

# The chat model every tutorial loads. Pick the row that matches your
# machine in HARDWARE.md. The default below is the recommended laptop
# size; a lab machine with a 16 GB+ GPU should use the full
# Qwen/Qwen2.5-7B-Instruct.
FAIR_LLM_DEMO_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Tutorial 12 only: an alternate folder of PDFs for the Archivist to
# ingest. Leave commented to use _scratch/12_archivist/corpus/.
# FAIR_LLM_ARCHIVE_DIR=
